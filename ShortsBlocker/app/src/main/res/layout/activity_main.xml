<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ShortsBlocker"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="-0.02"
            android:layout_marginTop="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Block distracting short videos."
            android:textSize="14sp"
            android:textColor="#7A7A8C"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="28dp"/>

        <!-- Status + toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A28"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 Inactive"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Start Blocking"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2ECC71"/>

        </LinearLayout>

        <!-- Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A28"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stats"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textColor="#7A7A8C"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTodayCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Today: 0 blocked"
                    android:textSize="14sp"
                    android:textColor="#00D4AA"/>

                <TextView
                    android:id="@+id/tvTotalCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="All time: 0 blocked"
                    android:textSize="14sp"
                    android:textColor="#AAAAAA"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvPlatformStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No blocks recorded yet"
                android:textSize="13sp"
                android:textColor="#9A9AAB"
                android:layout_marginTop="14dp"
                android:fontFamily="monospace"/>

        </LinearLayout>

        <!-- Platforms -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A28"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Platforms"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textColor="#7A7A8C"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvDomainCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blocking 0 domains"
                android:textSize="12sp"
                android:textColor="#5C5C6E"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:id="@+id/llPlatforms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>

        <!-- YouTube Shorts (separate from DNS platforms because it needs an
             accessibility service rather than a DNS rule) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A28"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube Shorts"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textColor="#7A7A8C"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="experimental — uses accessibility, not DNS"
                android:textSize="12sp"
                android:textColor="#5C5C6E"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/tvA11yStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚪ Not enabled — accessibility permission required"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/btnA11yEnable"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Enable in Settings"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#5A5C9A"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DNS can't tell Shorts apart from regular YouTube videos. This watches YouTube's UI and dismisses the Shorts player when it appears. Permission is granted system-wide; revoke any time in Settings → Accessibility."
                android:textSize="11sp"
                android:textColor="#7A7A8C"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- Debug card (read-only, helps users without ADB diagnose detection) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#15151F"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Shorts detector debug"
                    android:textSize="13sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:textColor="#7A7A8C"/>

                <Button
                    android:id="@+id/btnDebugRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Refresh"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#3A3A55"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDebugInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(open YouTube, swipe to a Short, then tap Refresh)"
                android:textSize="12sp"
                android:textColor="#9A9AAB"
                android:fontFamily="monospace"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.4"/>

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open source · No data collected · GPL-3.0"
            android:textSize="11sp"
            android:textColor="#444455"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</ScrollView>
